<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ls_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="运行日志"
                android:textColor="@color/ls_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="本次开发者模式记录"
                android:textColor="@color/ls_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/devLogClear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_ls_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="清空"
            android:textColor="@color/ls_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/devLogClose"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_ls_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="关闭"
            android:textColor="@color/ls_accent"
            android:textSize="9sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/devLogScroll"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:background="@color/ls_bg"
        android:minHeight="300dp"
        android:overScrollMode="never"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/devLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="暂无日志"
            android:textColor="@color/ls_text"
            android:textIsSelectable="true"
            android:textSize="9sp" />
    </ScrollView>
</LinearLayout>
