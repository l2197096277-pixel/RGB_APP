<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ls_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_ls_rgb" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:text="LS · UPDATE"
        android:textColor="@color/ls_tertiary"
        android:textSize="9sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif-medium"
        android:text="正在下载更新"
        android:textColor="@color/ls_text"
        android:textSize="21sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="请保持网络连接…"
        android:textColor="@color/ls_secondary"
        android:textSize="11sp" />

    <com.aurora.light.ui.DownloadPulseView
        android:id="@+id/downloadPulse"
        android:layout_width="122dp"
        android:layout_height="122dp"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/downloadPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:fontFamily="sans-serif-medium"
        android:text="0%"
        android:textColor="@color/ls_accent"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/downloadHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="下载完成后会自动打开安装界面"
        android:textColor="@color/ls_tertiary"
        android:textSize="9sp" />
</LinearLayout>
