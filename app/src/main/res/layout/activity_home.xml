<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_bg">

    <include
        android:id="@+id/homePage"
        layout="@layout/page_home_ls" />

    <include
        android:id="@+id/profilePage"
        layout="@layout/page_profile_ls"
        android:visibility="gone" />

    <include
        android:id="@+id/controlPage"
        layout="@layout/page_control_ls"
        android:visibility="gone" />

    <include
        android:id="@+id/musicPage"
        layout="@layout/page_music_ls"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#F2FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="光屿"
                android:textColor="@color/ls_accent"
                android:textSize="13sp" />

            <View
                android:id="@+id/navHomeDot"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ls_nav_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="我的"
                android:textColor="@color/ls_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/navProfileDot"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ls_nav_dot"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ls_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/introTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.18"
                android:text="LS"
                android:textColor="@color/ls_text"
                android:textSize="64sp" />

            <View
                android:id="@+id/introLine"
                android:layout_width="52dp"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ls_rgb" />

            <TextView
                android:id="@+id/introTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:text="让每一束光，都听你的"
                android:textColor="@color/ls_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
