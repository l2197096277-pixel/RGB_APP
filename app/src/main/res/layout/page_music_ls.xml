<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/backMusic"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ls_pill"
                    android:clickable="true"
                    android:contentDescription="返回"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_ls_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="音乐律动"
                        android:textColor="@color/ls_text"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="本地音乐 · 鼓点发码"
                        android:textColor="@color/ls_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/exitMusicMode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ls_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="退出模式"
                    android:textColor="@color/ls_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ls_rgb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ls_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/currentMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="还没有选择音乐"
                    android:textColor="@color/ls_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/musicState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="添加本地音乐后开始播放"
                    android:textColor="@color/ls_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/musicPrev"
                        android:layout_width="52dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_ls_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="上一首"
                        android:textColor="@color/ls_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/musicPlay"
                        android:layout_width="72dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_ls_rgb"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="播放"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/musicNext"
                        android:layout_width="52dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_ls_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="下一首"
                        android:textColor="@color/ls_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <com.aurora.light.ui.MusicBarsView
                android:id="@+id/musicBars"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ls_card"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ls_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="鼓点律动"
                        android:textColor="@color/ls_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/reactiveHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="需要录音权限，仅用于本地分析"
                        android:textColor="@color/ls_tertiary"
                        android:textSize="9sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/reactiveSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.86"
                    android:scaleY="0.86"
                    android:switchMinWidth="42dp"
                    android:thumbTint="@color/ls_accent"
                    android:trackTint="#B7C7FF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ls_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="律动灵敏度"
                        android:textColor="@color/ls_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/sensitivityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.6"
                        android:textColor="@color/ls_accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sensitivitySeek"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:max="30"
                    android:min="10"
                    android:progress="16"
                    android:progressTint="@color/ls_accent"
                    android:thumbTint="@color/ls_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="我的音乐"
                    android:textColor="@color/ls_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/addMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ls_rgb"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="+ 添加音乐"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/musicList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/musicEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ls_card"
                android:lineSpacingExtra="4dp"
                android:padding="20dp"
                android:text="还没有添加音乐\n支持 MP3 / FLAC / WAV / M4A / OGG\n不支持 QQ 音乐加密文件"
                android:textColor="@color/ls_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
